# Переменные окружения сервера. Скопировать в /etc/thousand.env.

# Порт и адрес Node.js: слушаем только localhost, наружу смотрит nginx.
API_PORT=3000
API_HOST=127.0.0.1

# Файл базы SQLite (рядом появятся -wal и -shm).
DB_FILE=/var/lib/thousand/thousand.sqlite

# Собранный фронтенд и миграции (по умолчанию ищутся относительно apps/server).
WEB_DIST=/opt/thousand/apps/web/dist
MIGRATIONS_DIR=/opt/thousand/apps/server/drizzle

# Сервер за nginx.
TRUST_PROXY=1
LOG_LEVEL=info
NODE_ENV=production
